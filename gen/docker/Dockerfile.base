# tbsgen sandbox base: python3.11 + pinned scientific stack (same versions as package.py's self-contained Dockerfile)
FROM python:3.11-slim
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN python -m pip install --no-cache-dir --default-timeout=120 -i "$PIP_INDEX_URL" numpy==2.1.3 scipy==1.14.1 pandas==2.2.3 \
        scikit-learn==1.5.2 statsmodels==0.14.4 pytest==8.3.3
ENV OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 NUMEXPR_NUM_THREADS=2
WORKDIR /work
